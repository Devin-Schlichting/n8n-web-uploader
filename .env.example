# URL des n8n-Webhooks, an den hochgeladene Dateien weitergeleitet werden.
# Achtung: Läuft diese App in Docker, zeigt "localhost" auf den Container selbst, nicht auf n8n!
#   - Docker, n8n läuft auf demselben Host (Port 5678 veröffentlicht):
#       http://host.docker.internal:5678/webhook/upload
#   - Docker, im selben Netzwerk wie der n8n-Container (siehe docker-compose.yml):
#       http://n8n:5678/webhook/upload
#   - Ohne Docker (npm start) oder n8n auf einem anderen Rechner:
#       http://localhost:5678/webhook/upload  bzw.  https://n8n.example.com/webhook/upload
# Die Produktiv-URL (/webhook/) verwenden, nicht die Test-URL (/webhook-test/),
# und den Workflow in n8n aktivieren.
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/upload

# Optionaler Header-Name + Wert, falls dein n8n-Webhook per Header-Auth abgesichert ist
# N8N_AUTH_HEADER_NAME=X-Webhook-Token
# N8N_AUTH_HEADER_VALUE=changeme

# Optionaler Zugriffsschutz für die Upload-Seite (HTTP Basic Auth).
# Nur aktiv, wenn beide Werte gesetzt sind. Empfohlen, sobald die Seite aus dem Internet erreichbar ist.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=changeme

# Port, auf dem diese Anwendung läuft (bei Docker: Port auf dem Host)
PORT=3000

# Max. Dateigröße in MB
MAX_FILE_SIZE_MB=50

# Wie lange (in Sekunden) höchstens auf eine Antwort von n8n gewartet wird
N8N_TIMEOUT_SECONDS=120
